# Package 09.1 requires only local Supabase values.
APP_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_BASE_URL=http://localhost:3000

# Edge helpers derive the JWKS endpoint from SUPABASE_URL:
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json

# Server-side Edge Function environment only.
# Never compile into Flutter/browser bundles and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store
